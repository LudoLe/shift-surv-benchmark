__pycache__/
*.py[cod]
*.pyo
*.pyd

# ── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb
!reproduce_figures.ipynb

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
**/.DS_Store

# ── Editors ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Virtual environments ──────────────────────────────────────────────────────
.env
.venv
venv/
env/
*.env

# ── Distribution / packaging ──────────────────────────────────────────────────
dist/
build/
*.egg-info/

# ── Temporary / local files ───────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
scratch/
local/
tmp/
